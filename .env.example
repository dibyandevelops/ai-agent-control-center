DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sentinelops
SENTINELOPS_PUBLIC_URL=http://localhost:3000
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=5
# Local operator bootstrap. Use an explicit password; the legacy admin token is
# accepted only as a migration fallback by `pnpm operator:create`.
SENTINELOPS_OPERATOR_EMAIL=admin@sentinelops.local
SENTINELOPS_OPERATOR_NAME=Local Admin
SENTINELOPS_OPERATOR_ROLE=admin
SENTINELOPS_OPERATOR_PASSWORD=replace-with-at-least-12-characters
SENTINELOPS_OPERATOR_ORGANIZATION=aperture-labs
SENTINELOPS_ADMIN_TOKEN=
# Organization-scoped Slack OAuth. Each tenant connects its own workspace and channel.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Generate with: openssl rand -base64 32
SLACK_CREDENTIAL_ENCRYPTION_KEY=
# Generate separately with: openssl rand -base64 32
MFA_ENCRYPTION_KEY=
RESEND_API_KEY=
SECURITY_DIGEST_FROM=SentinelOps <onboarding@resend.dev>
## Public workspace sign-up abuse protection (optional; enable only when both Cloudflare keys are configured)
TURNSTILE_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
SECURITY_DIGEST_TO=
SENTINELOPS_CRON_SECRET=
# Vercel Cron sends this value as a bearer credential automatically. In hosted
# environments it takes precedence over SENTINELOPS_CRON_SECRET.
CRON_SECRET=
ACTION_APPROVAL_TTL_MINUTES=30
POLICY_ACTIVATION_TTL_HOURS=24
POLICY_ACTIVATION_REMINDER_MINUTES=240

# Optional local demo configuration. Keep the real agent key in .env.local only.
SENTINELOPS_AGENT_API_KEY=
SENTINELOPS_URL=http://localhost:3000
# One GitHub App shared by SentinelOps, with one installation per customer organization.
GITHUB_APP_ID=
GITHUB_APP_SLUG=sentinelops
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Paste the full PEM. On Vercel, escaped newlines (\\n) are supported.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Approved deploy.release requests are executed automatically. Keep dry_run
# until a GitHub App installation and sandbox repository have been validated end to end.
RELEASE_EXECUTION_MODE=dry_run
RELEASE_EXECUTION_BATCH_SIZE=10
RELEASE_EXECUTION_LEASE_MINUTES=10
RELEASE_VERSION=v1.0.0-dry-run
RELEASE_REPOSITORY=your-account/sentinelops-release-sandbox
# Defaults to the GitHub repository's default branch when omitted.
RELEASE_COMMIT_SHA=
RELEASE_CHANGE_TICKET=CHG-DRY-RUN-001
RELEASE_ENVIRONMENT=production

# Lemon Squeezy Merchant of Record (MoR) Configuration
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=

# Dodo Payments Merchant of Record (MoR - Nepal & Global SaaS)
DODO_PAYMENTS_MODE=test
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=
DODO_PRO_MONTHLY_PRODUCT_ID=pdt_pro_monthly
DODO_PRO_ANNUAL_PRODUCT_ID=pdt_pro_annual
DODO_ENTERPRISE_MONTHLY_PRODUCT_ID=pdt_enterprise_monthly
DODO_ENTERPRISE_ANNUAL_PRODUCT_ID=pdt_enterprise_annual
