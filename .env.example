DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sentinelops
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# Local operator bootstrap. Use an explicit password; the legacy admin token is
# accepted only as a migration fallback by `pnpm operator:create`.
SENTINELOPS_OPERATOR_EMAIL=admin@sentinelops.local
SENTINELOPS_OPERATOR_NAME=Local Admin
SENTINELOPS_OPERATOR_ROLE=admin
SENTINELOPS_OPERATOR_PASSWORD=replace-with-at-least-12-characters
SENTINELOPS_OPERATOR_ORGANIZATION=aperture-labs
SENTINELOPS_ADMIN_TOKEN=
SLACK_APPROVAL_WEBHOOK_URL=
SENTINELOPS_CRON_SECRET=
POLICY_ACTIVATION_TTL_HOURS=24
POLICY_ACTIVATION_REMINDER_MINUTES=240

# Optional local demo configuration. Keep the real agent key in .env.local only.
SENTINELOPS_AGENT_API_KEY=
SENTINELOPS_URL=http://localhost:3000
GITHUB_TOKEN=
GITHUB_REPOSITORY=your-account/sentinelops-release-sandbox
GITHUB_RELEASE_MODE=draft
GITHUB_DRY_RUN=true
RELEASE_VERSION=v1.0.0-dry-run
# Defaults to the GitHub repository's default branch when omitted.
RELEASE_COMMIT_SHA=
RELEASE_CHANGE_TICKET=CHG-DRY-RUN-001
RELEASE_ENVIRONMENT=production
